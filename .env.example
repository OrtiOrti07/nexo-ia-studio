# Dirección pública de la web (metadatos, sitemap, JSON-LD).
# En GitHub Pages la define el flujo .github/workflows/pages.yml.
# NEXT_PUBLIC_SITE_URL=https://ortiorti07.github.io/nexo-ia-studio

# Versión estática para GitHub Pages (también la define el flujo de publicación)
# NEXT_PUBLIC_STATIC_EXPORT=1
# NEXT_PUBLIC_BASE_PATH=/nexo-ia-studio

# Formulario de contacto: dirección del formulario de Formspree
# (https://formspree.io → New form → copia el "endpoint").
# Ejemplo: https://formspree.io/f/abcdwxyz
# Sin ella, el formulario avisa de que el envío no está activado y no finge enviar nada.
# En GitHub Pages se configura como variable del repositorio con este mismo nombre.
NEXT_PUBLIC_CONTACT_ENDPOINT=
