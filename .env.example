# Dominio público de la web (metadatos, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://nexoia.studio

# Versión estática para GitHub Pages (lo define el flujo .github/workflows/pages.yml)
# NEXT_PUBLIC_STATIC_EXPORT=1
# NEXT_PUBLIC_BASE_PATH=/nexo-ia-studio

# Formulario en la versión estática: URL de un servicio de formularios
# (p. ej. Formspree o Web3Forms). Sin ella, el formulario ofrece enviar el mensaje por correo.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Envío del formulario con servidor propio (no aplica en GitHub Pages): configura UNA opción.
# Sin ninguna, el formulario valida los datos y avisa de que el envío no está conectado.

# Opción 1: webhook (Make, Zapier, n8n, CRM o backend propio). Recibe un POST con JSON.
CONTACT_WEBHOOK_URL=

# Opción 2: correo mediante la API de Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Remitente verificado en Resend, p. ej. "Nexo IA Studio <web@tudominio.com>"
CONTACT_FROM_EMAIL=
